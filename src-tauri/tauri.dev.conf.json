{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Patchdeck Local",
  "identifier": "com.local.patchdeck.dev",
  "build": {
    "beforeBuildCommand": "npm run build:dev"
  },
  "app": {
    "windows": [
      {
        "title": "Patchdeck Local",
        "width": 1280,
        "height": 820,
        "minWidth": 920,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 18, "y": 25 },
        "hiddenTitle": true
      }
    ]
  },
  "bundle": {
    "createUpdaterArtifacts": false,
    "targets": "app",
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
